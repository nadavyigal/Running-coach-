# Root-level ignores

# Next.js build outputs
/.next/
/out/
/build/
**/DerivedData/

# nested node_modules anywhere
**/node_modules/

# playwright artifacts
.playwright-mcp/

# local tooling and scratch
.mcp.json
Running-coach-/
v0/test-results/
apps/ios-old-old/App/Pods/
apps/ios-old-old/build/
apps/ios-native/build/

# accidental nested V0 directory
V0/V0/

# Dependencies
/node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Env files (do not commit secrets)
.env*

# OS/editor
.DS_Store
Thumbs.db
.vscode/
*.tsbuildinfo
.vercel
.env*.local

# GTM directory - exclude data files
GTM/*.txt
GTM/*.xlsx
GTM/*.xls

# Stale Capacitor leftovers (real iOS app is the apps/ios-native submodule)
apps/ios/

# macOS/iCloud duplicate artifacts: "page 2.tsx", "package 2.json", "README 2.md".
# iCloud Drive creates these on sync conflict and they are byte-identical or stale
# copies of the file beside them. Audited 2026-08-13: six had accumulated in
# tracked source, including a `page 2.tsx` frozen at the March pre-refactor version
# and three `*.test 2.ts` files that a test runner would happily collect as a
# second copy of the same suite. Ignored rather than deleted repeatedly, because
# deletion is a chore and this is a sync behaviour that will not stop.
# NOTE: three genuinely-tracked files legitimately carry " 2" in their names
# (config 2.xml, RunSmart Logo 2.png, RunSmart picture 2.jpg) and are force-added.
*[0-9].js
* [0-9].ts
* [0-9].tsx
* [0-9].json
* [0-9].md
* [0-9].cjs
* [0-9].mjs

# Garmin partner-application screenshot packages (16MB of PNG/JPG/zip across two
# dated capture runs, one of them an `_archive-not-used/` folder). These are
# submission artifacts regenerated by package-2026-06-30-screenshots.sh, not
# source. The script is tracked; its output is not.
docs/garmin-application/runsmart-garmin-screenshots-ios-*/
docs/garmin-application/runsmart-garmin-screenshots-ios-*.zip

# Per-machine Claude Code dev-server config; not shared.
.claude/launch.json
