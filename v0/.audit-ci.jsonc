{
  // audit-ci configuration.
  //
  // The allowlist is intentionally EMPTY. As of 2026-08-08 (WP-72) there are no
  // suppressed advisories: `audit-ci --config .audit-ci.jsonc` and
  // `audit-ci --moderate --config .audit-ci.jsonc` both pass on their own merits.
  //
  // It previously held ~60 entries, every one of which had become dead. They were
  // cleared by fixing the underlying dependencies rather than by suppressing them:
  //   - next 14.2.35 -> 16.3.0 (also moves its pinned postcss to 8.5.23)
  //   - sharp -> 0.35.3, and a lockfile refresh of tar, brace-expansion,
  //     js-yaml, svgo, nanoid, and postcss
  //   - removed `bundlesize` (unused; sole source of the axios advisory chain)
  //   - removed `cssnano` (declared but wired into no pipeline; sole source of svgo)
  //   - dompurify override raised to >=3.4.13
  //
  // Keep it empty. Adding an entry means shipping a known vulnerability, so it needs
  // a dated justification recorded alongside it, naming why the advisory is not
  // reachable in the deployed application and what would make it reachable again.
  "high": true,
  "allowlist": []
}
